# =============================================================================
# Spese - Docker Environment Configuration
# =============================================================================
# Copia questo file in .env nella stessa directory del docker-compose.yml
# e personalizza i valori.
#
# Uso: cp .env.docker .env
# =============================================================================

# --- App Settings ---
# Porta su cui esporre l'applicazione sull'host
APP_PORT=8080

# Chiave segreta Symfony (genera una stringa random)
# Puoi generarne una con: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change_me_in_production

# --- Google Sheets API ---
# ID del tuo Google Spreadsheet
SPREADSHEET_ID=

# Range del foglio con le spese (es: "Risposte del modulo 1!A1:G")
SPREADSHEET_RANGE="Risposte del modulo 1!A1:G"

# Range del foglio con i tipi di spese
SPREADSHEET_TIPISPESE_RANGE=TipiSpese
